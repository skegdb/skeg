{"id": "vget.missing", "op": "vget", "version": 1, "args": {"name": "cfni8", "id": 999}, "want": {"error_code": 1}}
{"id": "vsearch.top1", "op": "vsearch", "version": 1, "args": {"name": "cfni8", "k": 2, "query": [1, 0, 0, 0, 0, 0, 0, 0]}, "want": {"hits_top_id": 1, "hits_len": 2}}
{"id": "vsearch.v2", "op": "vsearch", "version": 2, "args": {"name": "cfni8", "k": 1, "query": [0, 1, 0, 0, 0, 0, 0, 0]}, "want": {"hits_top_id": 2, "version": 2}}
{"id": "vsearch.unknown.index", "op": "vsearch", "version": 1, "args": {"name": "cfnabsent", "k": 1, "query": [1, 0, 0, 0, 0, 0, 0, 0]}, "want": {"error_contains": "vindex 'cfnabsent' not found"}}
{"id": "vdel", "op": "vdel", "version": 1, "args": {"name": "cfni8", "id": 2}, "want": {"op": "ok"}}
{"id": "vindex.drop", "op": "vindex_drop", "version": 1, "args": {"name": "cfnf32"}, "want": {"op": "ok"}}
{"id": "vindex.drop.absent", "op": "vindex_drop", "version": 1, "args": {"name": "cfnabsent"}, "want": {"error_contains": "vindex 'cfnabsent' not found"}}
